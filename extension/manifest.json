{
  "manifest_version": 3,
  "name": "BossCopilot",
  "version": "0.1.0",
  "description": "在 Boss 直聘页面一键分析岗位匹配度，生成可直接发出的打招呼语。",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://*.zhipin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "BossCopilot — 分析当前岗位"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
